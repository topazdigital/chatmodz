<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Apache serve existing assets and directories directly.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Client-side routes (login, apply, admin, conversation, etc.) need the
  # React entry point instead of a server-side 404.
  RewriteRule ^ index.html [L]
</IfModule>