modules = ["nodejs-20", "web"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Chatmodz preview"

[[workflows.workflow]]
name = "Chatmodz preview"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 BASE_PATH=/ pnpm --filter @workspace/chatmodz run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 25549
externalPort = 80

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
CHATMODZ_ADMIN_EMAIL = "patrickndungu.pnn@gmail.com"
CHATMODZ_ADMIN_NAME = "Patrick Ndungu"

[userenv.development]
CHATMODZ_DEMO_MODE = "true"
